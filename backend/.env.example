# Application
APP_NAME="Portal do Churras API"
APP_VERSION="1.0.0"
DEBUG=False

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/portal_churras

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mercado Pago
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_PUBLIC_KEY=your-mercadopago-public-key
MP_WEBHOOK_SECRET=your-webhook-secret

# Claude API
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# CORS (comma-separated origins for production)
CORS_ORIGINS=*
