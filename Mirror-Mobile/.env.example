# URL base da API do backend — copie este arquivo para .env e ajuste conforme seu ambiente.
#
# Emulador Android:   http://10.0.2.2:8000/api
# iOS Simulator:      http://localhost:8000/api
# Celular físico:     http://IP_DA_SUA_MAQUINA:8000/api  (ex: http://192.168.1.10:8000/api)
# Web (expo start):   http://localhost:8000/api

EXPO_PUBLIC_API_URL=http://localhost:8000/api
